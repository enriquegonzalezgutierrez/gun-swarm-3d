{
  "name": "gun-swarm-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D hyper-casual crowd-runner and auto-shooter built with TypeScript, Three.js and Cannon-es.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "npm run typecheck && eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "cannon-es": "^0.20.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.11",
    "@types/three": "^0.169.0",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
